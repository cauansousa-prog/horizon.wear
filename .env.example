# Copie para .env na raiz. Nunca faça commit do arquivo .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Exclusiva do servidor: necessária para criar pedidos e atualizar pagamentos.
SUPABASE_SERVICE_ROLE_KEY=
# Mesma origem por padrão. Exemplo: ["http://localhost:5500"]
CORS_ORIGINS=[]
# Mercado Pago: necessário para habilitar o checkout real.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

MERCADOPAGO_WEBHOOK_SECRET=

# URL pública HTTPS usada pelo webhook. Exemplo: https://www.horizonwear.com.br
PUBLIC_BASE_URL=

SHIPPING_FLAT_BRL=0.00
